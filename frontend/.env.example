# Copy to `.env.local` and adjust.

# Base URL of the LegalMate REST API (no trailing slash).
# With the dev proxy below, keep the relative path; for a deployed API use its full URL, e.g. https://api.example.com/api/v1
VITE_API_BASE_URL=/api/v1

# true  = everything runs on built-in mock data (no backend needed), except the services listed in VITE_REAL_SERVICES
# false = every service calls the real backend
VITE_USE_MOCKS=true

# Services that call the real backend while the rest stay on mocks (comma separated).
#   auth    sign up, sign in, sessions
#   chat    the legal assistant (conversations, streaming answers, feedback)
#   profile account details and the onboarding questions that personalise answers
#   documents upload, reading scans, document analysis and chat attachments
VITE_REAL_SERVICES=auth,chat,profile,documents

# Largest file the upload screens accept, in MB. Keep it equal to the backend's MAX_UPLOAD_MB (the server enforces its own limit).
VITE_MAX_UPLOAD_MB=10

# Dev only: the Vite dev server forwards /api/* to the backend, so no CORS setup is needed locally.
VITE_PROXY_TARGET=http://localhost:8000

# Simulated network latency for mocks, in milliseconds.
VITE_MOCK_DELAY=300
