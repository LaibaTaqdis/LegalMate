# Copy to `.env.local` and adjust.

# Base URL of the LegalMate REST API (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# true  = use the built-in mock data (no backend needed)
# false = call the real backend at VITE_API_BASE_URL
VITE_USE_MOCKS=true

# Optional (dev only): set VITE_API_BASE_URL=/api/v1 and point this at the backend
# to proxy /api/* through the Vite dev server and avoid CORS.
# VITE_PROXY_TARGET=http://localhost:8000

# Simulated network latency for mocks, in milliseconds.
VITE_MOCK_DELAY=300
