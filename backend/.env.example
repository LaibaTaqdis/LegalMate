# Copy to .env (never commit .env). Share real values privately.
#
# Two kinds of settings:
#   BUILD-TIME  only needed on the machine that BUILDS the knowledge base from the raw PDFs (one person, now and then).
#               They are machine-specific paths and are NOT used by the running app or a deployment.
#   RUNTIME     needed by the running app (your laptop while developing, and the server when deployed).

# =====================================================================================================
# BUILD-TIME (corpus pipeline: python -m ingest.run_all, retrieval.embed_chunks, db.load)
# =====================================================================================================
# Folder holding Federal/, Punjab/, pdfs/ and For_AI_Chatbot.csv (the dataset is NOT stored in git; share it via Drive).
# Windows example: LEGALMATE_DATASET_DIR=C:\Users\you\Documents\AI Legal Assistant\dataset fyp
LEGALMATE_DATASET_DIR=
# Optional (QA report only): LegalMate_Law_Checklist_v2.xlsx
LEGALMATE_CHECKLIST=
# Optional: where generated files go (default backend/data, gitignored)
# LEGALMATE_DATA_DIR=

# =====================================================================================================
# RUNTIME (the app and chat engine)
# =====================================================================================================
# --- Supabase ---
# Use the *pooler* connection string (IPv4), not the direct one. Also used by db.load to load the knowledge base.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- DeepSeek (Phase 3+) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash   # the API lists: deepseek-flash, deepseek-v4-pro (checked 2026-11-06)

# --- App (Phase 4+) ---
# At least 32 random characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"  (the API refuses to start with a weak one)
JWT_SECRET=change-me
# Where the frontend runs (comma separated). Default: http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGINS=https://your-frontend.example.com
# Set to 1 ONLY behind a proxy you control (Cloudflare tunnel, Render): then the real visitor address is read from X-Forwarded-For
# for rate limiting. Left at 0 otherwise, because anyone can fake that header.
# TRUST_PROXY=0
# APP_ENV=production            # hides the /docs page
# ENABLE_ENGINE=1               # 0 = accounts and conversations only (no law library, no DeepSeek)
# WARM_ENGINE=1                 # load the law library in the background at start-up (about 30 s)
# CHAT_MSGS_PER_HOUR=0          # per-user questions per hour; 0 = no limit (default)
# CHAT_MSGS_PER_DAY=0           # per-user questions per day; 0 = no limit (default)
# ENGINE_CONCURRENCY=4          # answers computed at the same time
# ACCESS_TOKEN_MINUTES=15
# LLM_CACHE=off                 # the API keeps the DeepSeek disk cache OFF by default (it would store users' questions); on = enable

# --- LLM safety rails (Phase 3): the app refuses to exceed these; every live call is logged in data/llm_ledger.jsonl ---
# DEEPSEEK_THINKING=off          # off (default, cheaper/faster) | on (hidden reasoning tokens are billed as output)
# LLM_MAX_CALLS_PER_RUN=30       # hard cap of live DeepSeek calls per process (tests, pilots)
# LLM_DAILY_CALL_CAP=2000        # safety ceiling of live DeepSeek calls per day (about 1000 answers, a few US dollars); 0 = no ceiling
# LLM_MODE=live                  # live (cache + network) | replay (cache only: never calls DeepSeek)
