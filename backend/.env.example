# Copy to .env (never commit .env). Share real values privately.
#
# Two kinds of settings:
#   BUILD-TIME  only needed on the machine that BUILDS the knowledge base from the raw PDFs (one person, now and then).
#               They are machine-specific paths and are NOT used by the running app or a deployment.
#   RUNTIME     needed by the running app (your laptop while developing, and the server when deployed).

# =====================================================================================================
# BUILD-TIME (corpus pipeline: python -m ingest.run_all, retrieval.embed_chunks, db.load)
# =====================================================================================================
# Folder holding Federal/, Punjab/, pdfs/ and For_AI_Chatbot.csv (the dataset is NOT stored in git; share it via Drive).
# Windows example: LEGALMATE_DATASET_DIR=C:\Users\you\Documents\AI Legal Assistant\dataset fyp
LEGALMATE_DATASET_DIR=
# Optional (QA report only): LegalMate_Law_Checklist_v2.xlsx
LEGALMATE_CHECKLIST=
# Optional: where generated files go (default backend/data, gitignored)
# LEGALMATE_DATA_DIR=

# =====================================================================================================
# RUNTIME (the app and chat engine)
# =====================================================================================================
# --- Supabase ---
# Use the *pooler* connection string (IPv4), not the direct one. Also used by db.load to load the knowledge base.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- DeepSeek (Phase 3+) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash   # the API lists: deepseek-flash, deepseek-v4-pro (checked 2026-11-06)

# --- App (Phase 4+) ---
# At least 32 random characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"  (the API refuses to start with a weak one)
JWT_SECRET=change-me
# Where the frontend runs (comma separated). Default: http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGINS=https://your-frontend.example.com
# Set to 1 ONLY behind a proxy you control (Cloudflare tunnel, Render): then the real visitor address is read from X-Forwarded-For
# for rate limiting. Left at 0 otherwise, because anyone can fake that header.
# TRUST_PROXY=0
# APP_ENV=production            # hides the /docs page
# ENABLE_ENGINE=1               # 0 = accounts and conversations only (no law library, no DeepSeek)
# WARM_ENGINE=1                 # load the law library in the background at start-up (about 30 s)
# CHAT_MSGS_PER_HOUR=0          # per-user questions per hour; 0 = no limit (default)
# CHAT_MSGS_PER_DAY=0           # per-user questions per day; 0 = no limit (default)
# ENGINE_CONCURRENCY=4          # answers computed at the same time
# ACCESS_TOKEN_MINUTES=15
# LLM_CACHE=off                 # the API keeps the DeepSeek disk cache OFF by default (it would store users' questions); on = enable

# --- Documents (Phase 5): upload, text extraction, analysis. Every value below is optional; the number shown is the default. ---
# MAX_UPLOAD_MB=10                  # largest file accepted
# MAX_PAGES=10                      # PDF pages accepted (a photo counts as one page; Word is estimated at ~3000 characters a page)
# MAX_TEXT_CHARS=200000             # text kept per document; the rest is cut and the user is told
# DOCX_MAX_UNCOMPRESSED_MB=50       # zip-bomb guard for Word files
# MAX_IMAGE_PIXELS=40000000         # photos bigger than this are refused (decompression-bomb guard)
# OCR_ENABLED=1                     # read scans and photos (0 = refuse them; saves ~200 MB of memory)
# OCR_DEFER_CHAT=1                  # a photo attached in chat is accepted at once and read while the answer is prepared (0 = read at upload)
# PENDING_DOC_HOURS=24              # an attached photo that is never sent with a question is removed after this many hours
# OCR_WARM=1                        # load and prime the OCR readers when the server starts (about 15 s in the background), so the first photo is not slow
# OCR_DPI=200                       # resolution a scanned page is rendered at before reading (higher = slower, a little more accurate)
# OCR_MIN_PAGE_CHARS=40             # a PDF page with less text than this is treated as a scan
# OCR_CONCURRENCY=1                 # OCR jobs at once (each is heavy on CPU and memory; keep 1 on a laptop)
# OCR_LANGS=en,ur                   # scripts the OCR reads: en = English and digits, ur = Urdu. Use en alone to switch Urdu off (saves memory and time)
# OCR_URDU_MODEL=v5                 # Urdu recognition model generation: v5 (measured better) or v4
# OCR_URDU_MIN_SCORE=0.50           # a line read as Urdu must score at least this to be kept
# OCR_URDU_TRIGGER=0.20             # the Urdu reader runs when more than this share of the page's ink was not read as English
# OCR_SCRIPT_MIN=0.40               # share of Arabic-script letters a line needs to count as Urdu
# OCR_MIN_CONFIDENCE=0.60           # below this average the user is warned the scan was hard to read
# DOCS_PER_USER=25                  # stored documents per user (0 = no limit)
# UPLOADS_PER_HOUR=30               # per user (0 = no limit)
# DOC_RETENTION_DAYS=30             # extracted text is deleted after this many days (0 = keep until the user deletes it)
# ANALYSIS_RETENTION_DAYS=90        # finished analyses are deleted after this many days (0 = keep)
# ATTACHMENTS_PER_MESSAGE=3         # files attached to one chat question (max 5)
# CHAT_DOC_CHARS=6000               # characters of a document shown to the assistant for one chat question (more = better answers, more cost)
# ANALYSIS_QUICK_CHARS=15000        # document text read by a quick analysis
# ANALYSIS_DETAILED_CHARS=40000     # document text read by a detailed analysis
# ANALYSIS_QUICK_TOKENS=2800        # longest answer the model may write (quick); 1800 cut answers off in testing
# ANALYSIS_DETAILED_TOKENS=4800     # (detailed)
# ANALYSIS_MAX_DOCS=3               # documents analysed together
# ANALYSIS_CONCURRENCY=2            # analyses running at once on the server
# ANALYSIS_PER_USER_RUNNING=2       # analyses one user may have running at once
# ANALYSIS_PER_DAY=0                # per user (0 = no limit)
# ANALYSIS_STALE_MINUTES=15         # a job still "running" after this long (the server was restarted) is marked failed
# ANALYSIS_PAGE_SIZE=10            # rows per page in the Analysis history (the browser may ask for fewer; never more than 50)
# LAW_REFS_ENABLED=1               # show "Related laws" on an analysis (a reviewed table; the law text comes from the law library)
# LAW_REFS_MAX=8                   # laws shown in the box (a clause's main law is always kept, even beyond this)
# LAW_REFS_PER_CLAUSE=2            # laws linked from one clause
# LAW_REFS_QUOTE_CHARS=260         # characters of the law's own wording shown for each

# --- LLM safety rails (Phase 3): the app refuses to exceed these; every live call is logged in data/llm_ledger.jsonl ---
# DEEPSEEK_THINKING=off          # off (default, cheaper/faster) | on (hidden reasoning tokens are billed as output)
# LLM_MAX_CALLS_PER_RUN=30       # hard cap of live DeepSeek calls per process (tests, pilots)
# LLM_DAILY_CALL_CAP=2000        # safety ceiling of live DeepSeek calls per day (about 1000 answers, a few US dollars); 0 = no ceiling
# LLM_MODE=live                  # live (cache + network) | replay (cache only: never calls DeepSeek)
