# Copy to .env (never commit .env). Share real values privately.
#
# Two kinds of settings:
#   BUILD-TIME  only needed on the machine that BUILDS the knowledge base from the raw PDFs (one person, now and then).
#               They are machine-specific paths and are NOT used by the running app or a deployment.
#   RUNTIME     needed by the running app (your laptop while developing, and the server when deployed).

# =====================================================================================================
# BUILD-TIME (corpus pipeline: python -m ingest.run_all, retrieval.embed_chunks, db.load)
# =====================================================================================================
# Folder holding Federal/, Punjab/, pdfs/ and For_AI_Chatbot.csv (the dataset is NOT stored in git; share it via Drive).
# Windows example: LEGALMATE_DATASET_DIR=C:\Users\you\Documents\AI Legal Assistant\dataset fyp
LEGALMATE_DATASET_DIR=
# Optional (QA report only): LegalMate_Law_Checklist_v2.xlsx
LEGALMATE_CHECKLIST=
# Optional: where generated files go (default backend/data, gitignored)
# LEGALMATE_DATA_DIR=

# =====================================================================================================
# RUNTIME (the app and chat engine)
# =====================================================================================================
# --- Supabase ---
# Use the *pooler* connection string (IPv4), not the direct one. Also used by db.load to load the knowledge base.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- DeepSeek (Phase 3+) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash   # confirm exact id against DeepSeek's official docs

# --- App (Phase 4+) ---
JWT_SECRET=change-me
